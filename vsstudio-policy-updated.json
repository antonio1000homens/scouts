{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowSTSAssumeRoleWithWebIdentity",
            "Effect": "Allow",
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Resource": "arn:aws:iam::243857182133:role/*"
        },
        {
            "Sid": "AllowCreateAndManageSpecificIamRoles",
            "Effect": "Allow",
            "Action": [
                "iam:CreateRole",
                "iam:DeleteRole",
                "iam:GetRole",
                "iam:PassRole",
                "iam:PutRolePolicy",
                "iam:DeleteRolePolicy",
                "iam:GetRolePolicy",
                "iam:AttachRolePolicy",
                "iam:DetachRolePolicy",
                "iam:ListRolePolicies"
            ],
            "Resource": [
                "arn:aws:iam::243857182133:role/scouts-lambda-role",
                "arn:aws:iam::243857182133:role/scouts-*"
            ]
        },
        {
            "Sid": "AllowAttachManagedPolicies",
            "Effect": "Allow",
            "Action": [
                "iam:AttachRolePolicy",
                "iam:DetachRolePolicy"
            ],
            "Resource": "*",
            "Condition": {
                "StringLike": {
                    "iam:PassedToService": "lambda.amazonaws.com"
                }
            }
        },
        {
            "Sid": "LambdaAndLayerManagement",
            "Effect": "Allow",
            "Action": [
                "lambda:CreateFunction",
                "lambda:UpdateFunctionCode",
                "lambda:UpdateFunctionConfiguration",
                "lambda:GetFunction",
                "lambda:GetFunctionConfiguration",
                "lambda:DeleteFunction",
                "lambda:PublishLayerVersion",
                "lambda:ListLayers",
                "lambda:ListLayerVersions",
                "lambda:GetLayerVersion",
                "lambda:DeleteLayerVersion",
                "lambda:AddPermission",
                "lambda:RemovePermission",
                "lambda:InvokeFunction",
                "lambda:TagResource",
                "lambda:UntagResource"
            ],
            "Resource": [
                "arn:aws:lambda:eu-west-2:243857182133:function:scouts",
                "arn:aws:lambda:eu-west-2:243857182133:layer:scouts-shared:*",
                "arn:aws:lambda:eu-west-2:243857182133:function:*",
                "arn:aws:lambda:eu-west-2:243857182133:layer:*"
            ]
        },
        {
            "Sid": "CloudFormationDeploy",
            "Effect": "Allow",
            "Action": [
                "cloudformation:CreateChangeSet",
                "cloudformation:DeleteStack",
                "cloudformation:DeleteChangeSet",
                "cloudformation:DescribeChangeSet",
                "cloudformation:DescribeStacks",
                "cloudformation:ExecuteChangeSet",
                "cloudformation:GetTemplateSummary",
                "cloudformation:ValidateTemplate"
            ],
            "Resource": [
                "arn:aws:cloudformation:eu-west-2:243857182133:stack/nfc-lambdas/*",
                "arn:aws:cloudformation:eu-west-2:243857182133:stack/scouts-lambda/*",
                "arn:aws:cloudformation:eu-west-2:243857182133:stack/slack-handler-lambda/*",
                "arn:aws:cloudformation:eu-west-2:243857182133:stack/scouts2sqs-lambda/*",
                "arn:aws:cloudformation:eu-west-2:243857182133:stack/sqs2scouts-lambda/*",
                "arn:aws:cloudformation:eu-west-2:243857182133:stack/alexa-confirmation-lambda/*",
                "arn:aws:cloudformation:eu-west-2:243857182133:stack/scouts-cloudfront/*",
                "arn:aws:cloudformation:eu-west-2:243857182133:changeSet/*/*",
                "arn:aws:cloudformation:eu-west-1:243857182133:stack/alexa-confirmation-lambda/*",
                "arn:aws:cloudformation:eu-west-1:243857182133:changeSet/*/*"
            ]
        },
        {
            "Sid": "S3AccessForBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation",
                "s3:GetBucketPolicy"
            ],
            "Resource": [
                "arn:aws:s3:::2ndtolworth",
                "arn:aws:s3:::scouts-2ndtolworth-prod-553490163883"
            ]
        },
        {
            "Sid": "S3ObjectWriteAccess",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:PutObjectAcl",
                "s3:GetObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::2ndtolworth",
                "arn:aws:s3:::2ndtolworth/*",
                "arn:aws:s3:::scouts-2ndtolworth-prod-553490163883",
                "arn:aws:s3:::scouts-2ndtolworth-prod-553490163883/*"
            ]
        },
        {
            "Sid": "CloudWatchLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents",
                "logs:GetLogEvents",
                "logs:DescribeLogStreams"
            ],
            "Resource": "arn:aws:logs:eu-west-2:243857182133:log-group:/aws/lambda/scouts*"
        },
        {
            "Sid": "S3BucketCreation",
            "Effect": "Allow",
            "Action": [
                "s3:CreateBucket",
                "s3:PutBucketPublicAccessBlock",
                "s3:PutBucketVersioning"
            ],
            "Resource": [
                "arn:aws:s3:::2ndtolworth",
                "arn:aws:s3:::scouts-2ndtolworth-prod-553490163883"
            ]
        },
        {
            "Sid": "AllowReadOnlyIAMAndSTS",
            "Effect": "Allow",
            "Action": [
                "iam:ListRoles",
                "iam:ListPolicies",
                "sts:GetCallerIdentity"
            ],
            "Resource": "*"
        }
    ]
}
