# Copy this file to `.env` (kept out of version control).
# Store only non-secret configuration and secret-manager identifiers here.

AWS_REGION=eu-west-2
TARGET_BUCKET=example-scouts-bucket

# Scouts CloudFormation deploys
BWS_REQUIRED_API_KEY_SECRET_ID=

# Slack/Gemini-backed SQS lambdas
BWS_SLACK_SIGNING_SECRET_SECRET_ID=
BWS_SLACK_BOT_TOKEN_SECRET_ID=
BWS_GEMINI_API_KEY_SECRET_ID=

# Cloudflare worker deployment token identifier
BW_SCOUTS_CF_DEPLOY=

# Optional direct overrides for local/emergency use only.
# Never commit real values.
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# GEMINI_API_KEY=
# REQUIRED_API_KEY=
