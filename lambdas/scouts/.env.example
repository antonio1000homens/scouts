# Copy this file to `.env` (kept out of version control).
# Store only non-secret configuration and Bitwarden secret UUIDs here.

AWS_REGION=eu-west-2
TARGET_BUCKET=2ndtolworth

# Scouts CloudFormation deploys
# Bitwarden secret name: SCOUTS_REQUIRED_API_KEY
BWS_REQUIRED_API_KEY_SECRET_ID=

# Slack/Gemini-backed SQS lambdas
# Bitwarden secret name: AWS2022_SLACK_SIGNING_SECRET
BWS_SLACK_SIGNING_SECRET_SECRET_ID=
# Bitwarden secret name: AWS2022_SLACK_BOT
BWS_SLACK_BOT_TOKEN_SECRET_ID=
# Bitwarden secret name: SCOUTS_GEMINI_API_KEY
BWS_GEMINI_API_KEY_SECRET_ID=

# Cloudflare worker deploy token
# Bitwarden secret name: Scouts Cloudflare deploy token
BW_SCOUTS_CF_DEPLOY=

# Optional direct overrides for emergencies only.
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# GEMINI_API_KEY=
# REQUIRED_API_KEY=
